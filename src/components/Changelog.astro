---
// Renders src/data/changelog.yaml as release cards, newest version first.
import { getCollection } from 'astro:content';

const semver = (v: string) => v.split(/[.-]/).map((n) => parseInt(n, 10) || 0);
const newestFirst = (a: string, b: string) => {
	const [x, y] = [semver(a), semver(b)];
	for (let i = 0; i < Math.max(x.length, y.length); i++) {
		if ((y[i] ?? 0) !== (x[i] ?? 0)) return (y[i] ?? 0) - (x[i] ?? 0);
	}
	return 0;
};

const releases = (await getCollection('changelog')).sort((a, b) => newestFirst(a.id, b.id));
const latest = releases.find((r) => r.data.date)?.id;

const formatDate = (d: Date | string) => {
	const date = typeof d === 'string' ? new Date(`${d}T00:00:00Z`) : d;
	return Number.isNaN(date.getTime())
		? String(d)
		: date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};

const LABEL = { new: 'New', improved: 'Improved', fix: 'Fix', removed: 'Removed' } as const;
---

<div class="cl not-content">
	{
		releases.map((r) => (
			<article class="cl-release" id={`v${r.id}`}>
				<header class="cl-head">
					<h2>
						<a href={`#v${r.id}`}>v{r.id}</a>
					</h2>
					{r.data.date ? (
						<time class="cl-date" datetime={typeof r.data.date === 'string' ? r.data.date : r.data.date.toISOString().slice(0, 10)}>
							{formatDate(r.data.date)}
						</time>
					) : (
						<span class="cl-upcoming">Upcoming</span>
					)}
					{r.id === latest && <span class="cl-latest">Latest</span>}
					{r.data.engines && <span class="cl-engines">{r.data.engines}</span>}
				</header>
				{r.data.summary && <p class="cl-summary">{r.data.summary}</p>}
				<ul class="cl-list">
					{r.data.changes.map((c) => (
						<li>
							<span class={`cl-tag t-${c.type}`}>{LABEL[c.type]}</span>
							<span class="cl-text">{c.text}</span>
						</li>
					))}
				</ul>
			</article>
		))
	}
</div>

<style>
	.cl {
		display: grid;
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.cl-release {
		padding: clamp(1.25rem, 3vw, 1.75rem);
		border-radius: 14px;
		border: 1px solid var(--sl-color-gray-5);
		background: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
		scroll-margin-top: 5rem;
	}
	.cl-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 0.9rem;
	}
	.cl-head h2 {
		margin: 0;
		font-family: var(--nc-head-font, sans-serif);
		font-size: 1.6rem;
		letter-spacing: -0.02em;
	}
	.cl-head h2 a {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.cl-head h2 a:hover {
		color: var(--sl-color-accent);
	}
	.cl-date,
	.cl-upcoming,
	.cl-engines {
		font: 500 0.8rem/1 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	.cl-upcoming {
		color: var(--sl-color-accent);
	}
	.cl-latest {
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		font: 600 0.7rem/1 var(--sl-font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #1a0e02;
		background: var(--sl-color-accent);
	}
	.cl-engines {
		margin-left: auto;
	}
	.cl-summary {
		margin: 0.75rem 0 0;
		color: var(--sl-color-gray-2);
	}
	.cl-list {
		display: grid;
		gap: 0.65rem;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.cl-list li {
		display: grid;
		grid-template-columns: 5.6rem 1fr;
		gap: 0.9rem;
		align-items: baseline;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.cl-tag {
		justify-self: start;
		padding: 0.18rem 0.5rem;
		border-radius: 5px;
		border: 1px solid currentColor;
		font: 600 0.68rem/1.2 var(--sl-font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.t-new {
		color: #5fd35a;
	}
	.t-improved {
		color: #4aa3ff;
	}
	.t-fix {
		color: #f5a623;
	}
	.t-removed {
		color: #ef5b5b;
	}
	:root[data-theme='light'] .t-new {
		color: #1f8a1b;
	}
	:root[data-theme='light'] .t-improved {
		color: #1a6fd1;
	}
	:root[data-theme='light'] .t-fix {
		color: #a86700;
	}
	:root[data-theme='light'] .t-removed {
		color: #c12e2e;
	}
	@media (max-width: 560px) {
		.cl-list li {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
		.cl-engines {
			margin-left: 0;
		}
	}
</style>
