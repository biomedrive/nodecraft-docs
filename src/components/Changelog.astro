---
// Renders src/data/changelog.yaml as release cards, newest version first.
import { getCollection } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const semver = (v: string) => v.split(/[.-]/).map((n) => parseInt(n, 10) || 0);
const newestFirst = (a: string, b: string) => {
	const [x, y] = [semver(a), semver(b)];
	for (let i = 0; i < Math.max(x.length, y.length); i++) {
		if ((y[i] ?? 0) !== (x[i] ?? 0)) return (y[i] ?? 0) - (x[i] ?? 0);
	}
	return 0;
};

const releases = (await getCollection('changelog')).sort((a, b) => newestFirst(a.id, b.id));
const latest = releases.find((r) => r.data.date)?.id;

const formatDate = (d: Date | string) => {
	const date = typeof d === 'string' ? new Date(`${d}T00:00:00Z`) : d;
	return Number.isNaN(date.getTime())
		? String(d)
		: date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};

const LABEL = { new: 'New', improved: 'Improved', fix: 'Fix', removed: 'Removed' } as const;

// A release's notice is Markdown (paragraphs, bold, code blocks), rendered once
// at build time.
// public/ files need the site base prefixed; import.meta.env.BASE_URL carries it.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const markdown = await createMarkdownProcessor({ syntaxHighlight: false });
const notices = new Map<string, string>();
for (const r of releases) {
	if (r.data.notice) notices.set(r.id, (await markdown.render(r.data.notice)).code);
}
---

<div class="cl not-content">
	{
		releases.map((r) => (
			<article class="cl-release" id={`v${r.id}`}>
				<header class="cl-head">
					<h2>
						<a href={`#v${r.id}`}>v{r.id}</a>
					</h2>
					{r.data.date ? (
						<time class="cl-date" datetime={typeof r.data.date === 'string' ? r.data.date : r.data.date.toISOString().slice(0, 10)}>
							{formatDate(r.data.date)}
						</time>
					) : (
						<span class="cl-upcoming">Upcoming</span>
					)}
					{r.id === latest && <span class="cl-latest">Latest</span>}
					{r.data.engines && <span class="cl-engines">{r.data.engines}</span>}
				</header>
				{r.data.summary && <p class="cl-summary">{r.data.summary}</p>}
				{r.data.images && (
					<div class="cl-shots">
						{r.data.images.map((img) => (
							<figure>
								<img src={base + img.src.replace(/^\//, '')} alt={img.alt} loading="lazy" decoding="async" />
								{img.caption && <figcaption>{img.caption}</figcaption>}
							</figure>
						))}
					</div>
				)}
				{notices.has(r.id) && <div class="cl-notice" set:html={notices.get(r.id)} />}
				<ul class="cl-list">
					{r.data.changes.map((c) => (
						<li>
							<span class={`cl-tag t-${c.type}`}>{LABEL[c.type]}</span>
							<span class="cl-text">{c.text}</span>
						</li>
					))}
				</ul>
			</article>
		))
	}
</div>

<style>
	.cl-shots {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		margin: 0 0 1rem;
	}
	.cl-shots figure {
		margin: 0;
	}
	.cl-shots img {
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		display: block;
	}
	.cl-shots figcaption {
		margin-top: 0.4rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
	}

	.cl {
		display: grid;
		/* minmax(0, 1fr): a long line in a notice's code block scrolls inside
		   the block instead of widening every card past the page. */
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.cl-release {
		padding: clamp(1.25rem, 3vw, 1.75rem);
		border-radius: 14px;
		border: 1px solid var(--sl-color-gray-5);
		background: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
		scroll-margin-top: 5rem;
	}
	.cl-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 0.9rem;
	}
	.cl-head h2 {
		margin: 0;
		font-family: var(--nc-head-font, sans-serif);
		font-size: 1.6rem;
		letter-spacing: -0.02em;
	}
	.cl-head h2 a {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.cl-head h2 a:hover {
		color: var(--sl-color-accent);
	}
	.cl-date,
	.cl-upcoming,
	.cl-engines {
		font: 500 0.8rem/1 var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	.cl-upcoming {
		color: var(--sl-color-accent);
	}
	.cl-latest {
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		font: 600 0.7rem/1 var(--sl-font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #1a0e02;
		background: var(--sl-color-accent);
	}
	.cl-engines {
		margin-left: auto;
	}
	.cl-summary {
		margin: 0.75rem 0 0;
		color: var(--sl-color-gray-2);
	}
	.cl-notice {
		margin: 1.1rem 0 0;
		padding: 1rem 1.15rem;
		border-radius: 10px;
		border: 1px solid color-mix(in srgb, #f5a623 55%, transparent);
		border-left-width: 4px;
		background: color-mix(in srgb, #f5a623 9%, transparent);
		color: var(--sl-color-gray-2);
		line-height: 1.6;
	}
	.cl-notice :global(p) {
		margin: 0 0 0.7rem;
	}
	.cl-notice :global(p:last-child) {
		margin-bottom: 0;
	}
	.cl-notice :global(strong) {
		color: var(--sl-color-white);
	}
	.cl-notice :global(pre) {
		margin: 0 0 0.7rem;
		padding: 0.75rem 0.9rem;
		overflow-x: auto;
		border-radius: 8px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-black);
		font: 0.8rem/1.5 var(--sl-font-mono);
	}
	.cl-notice :global(code) {
		font-family: var(--sl-font-mono);
	}
	:root[data-theme='light'] .cl-notice {
		border-color: color-mix(in srgb, #a86700 55%, transparent);
		background: color-mix(in srgb, #f5a623 12%, transparent);
	}
	.cl-list {
		display: grid;
		gap: 0.65rem;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.cl-list li {
		display: grid;
		grid-template-columns: 5.6rem 1fr;
		gap: 0.9rem;
		align-items: baseline;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.cl-tag {
		justify-self: start;
		padding: 0.18rem 0.5rem;
		border-radius: 5px;
		border: 1px solid currentColor;
		font: 600 0.68rem/1.2 var(--sl-font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.t-new {
		color: #5fd35a;
	}
	.t-improved {
		color: #4aa3ff;
	}
	.t-fix {
		color: #f5a623;
	}
	.t-removed {
		color: #ef5b5b;
	}
	:root[data-theme='light'] .t-new {
		color: #1f8a1b;
	}
	:root[data-theme='light'] .t-improved {
		color: #1a6fd1;
	}
	:root[data-theme='light'] .t-fix {
		color: #a86700;
	}
	:root[data-theme='light'] .t-removed {
		color: #c12e2e;
	}
	@media (max-width: 560px) {
		.cl-list li {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
		.cl-engines {
			margin-left: 0;
		}
	}
</style>
